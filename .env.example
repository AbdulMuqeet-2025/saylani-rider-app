# Use a restricted app role in deployment, not the Neon owner account.
DATABASE_URL=postgresql://saylani_rider_app:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
AUTH_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
# Development defaults are used if WEB_ORIGINS is empty.
API_PORT=3001
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set TRUST_PROXY=true only when the host's trusted proxy sets X-Forwarded-For.
TRUST_PROXY=false
